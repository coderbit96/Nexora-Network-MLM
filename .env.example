# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: E.164 WhatsApp number, digits only. If omitted, the floating button
# opens WhatsApp's share flow instead of claiming to be a support chat.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=919999999999
NODE_ENV=development

# MongoDB (use a replica set for transactional financial workflows)
MONGODB_URI=mongodb://127.0.0.1:27017/mlm_platform?replicaSet=rs0
MONGODB_DB_NAME=mlm_platform
# Tune these for the deployment's expected concurrency and Atlas connection cap.
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0

# Comma-separated HTTPS hosts accepted by Next.js image optimization. Do not
# add broad wildcards; add each approved product-image CDN explicitly.
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=images.example.com

# Firebase web/client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:your-app-id

# Firebase Admin SDK (store the private key with literal \n characters)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Development owner provisioning. These are read only by `npm run seed:admin` and
# receive the unrestricted SUPER_ADMIN role. Never use a weak value outside local development.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Payment provider placeholders - do not expose secrets with NEXT_PUBLIC_.
# `mock` is development-only and is rejected in production.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true
PAYMENT_API_KEY=development-mock-not-a-real-key
PAYMENT_WEBHOOK_SECRET=development-mock-webhook-secret

# Razorpay (optional; used only after a Razorpay provider adapter is implemented)
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Base64-encoded 32-byte key for server-only encryption of bank/payment details.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
