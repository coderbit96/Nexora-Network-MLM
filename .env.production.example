# Copy to your deployment provider's encrypted environment configuration.
# This file contains placeholders only. Never commit a populated .env file.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mlm_platform
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=images.example.com

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:replace-me

# Server-only Firebase Admin values: configure as encrypted deployment secrets.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Production requires a real, verified provider adapter. Mock payments are
# deliberately prohibited by the application when NODE_ENV=production.
PAYMENT_PROVIDER=replace-with-configured-provider
PAYMENT_MOCK_ENABLED=false
PAYMENT_API_KEY=replace-with-provider-api-key
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Base64-encoded 32-byte key, stored as a server-only secret.
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
